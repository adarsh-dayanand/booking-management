# Postgres
DATABASE_URL=postgres://localhost:5432/booking_management_bot
DATABASE_URL_TEST=postgres://localhost:5432/booking_management_bot_test

# Server
PORT=4000
BASE_URL=http://localhost:4000

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Used to encrypt Google refresh tokens at rest (32 random bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY=replace-with-32-random-bytes-base64

# Google Calendar OAuth (create in Google Cloud Console, see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# WhatsApp Cloud API (create via Meta developer console, see README)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-any-string-you-choose
# Required when NODE_ENV=production (unsigned webhooks are rejected there).
WHATSAPP_APP_SECRET=
# Optional (platform-owned numbers): an approved Meta template with ONE variable and fixed text around it, e.g.
# "Update from your clinic: {{1}}. Reply here to book or cancel." (Meta rejects a body that is only "{{1}}").
# Consultants who connect their own number get a template created automatically. Used as a fallback when a free-text
# reminder/approval request fails because the recipient hasn't messaged in the last 24h.
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_NOTIFY_TEMPLATE_LANG=en
# Embedded Signup: lets each consultant connect their OWN WhatsApp number from the dashboard. Needs a Meta app with
# WhatsApp + Facebook Login for Business, and WHATSAPP_APP_SECRET above. See the README.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Graph API version used for sending (match the one in your Meta app's API Setup page).
WHATSAPP_GRAPH_VERSION=v25.0

# Background loop (calendar sync, reminders). Set DISABLE_SCHEDULER=1 to turn it off.
SCHEDULER_INTERVAL_MS=300000

# The booking agent. With a key, an LLM runs the conversation (book / check / reschedule / cancel / FAQs).
# Leave LLM_API_KEY blank to fall back to the deterministic numbered-menu flow (book only, no API cost).
# Switching model or vendor is just editing these four lines and restarting; no code changes.
#   LLM_PROVIDER  gemini | openai | anthropic
#   LLM_API_KEY   key for that provider (Gemini: aistudio.google.com/apikey, OpenAI: platform.openai.com/api-keys,
#                 Anthropic: console.anthropic.com/settings/keys)
#   LLM_MODEL     optional; defaults: gemini-2.5-flash | gpt-4.1-mini | claude-sonnet-5-5. Must support tool calling.
#   LLM_BASE_URL  optional; a proxy, or any OpenAI-compatible API with LLM_PROVIDER=openai
#                 (OpenRouter https://openrouter.ai/api/v1, Groq https://api.groq.com/openai/v1, Ollama http://localhost:11434/v1, ...)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=

# Email alerts to the consultant, sent with Resend (https://resend.com): when a patient books, asks for an appointment,
# reschedules or cancels, every dashboard login of that clinic gets an email (in addition to the WhatsApp message to the
# staff number, if set). Off until both are set. EMAIL_FROM must use a domain you verified in Resend,
# e.g. Bookings <bookings@yourdomain.com> (for a quick test, Resend allows onboarding@resend.dev, to your own address only).
RESEND_API_KEY=
EMAIL_FROM=

# Swagger UI at /docs and agent trace (tool calls/results, system prompt) in API responses.
# Both default to ON outside production and OFF in production; set to 1 to force on.
ENABLE_DOCS=
AGENT_TRACE=

# Country code added to 10-digit numbers typed without one, so "98765 43210" and "+91 98765 43210" are the same patient.
DEFAULT_COUNTRY_CODE=91

# Admin = the platform operator (consultants are the clinics, users are the end users). Per-consultant Razorpay keys are
# NOT set here: the admin stores them through PUT /v1/admin/tenants/<slug>/payments, authenticated with this token.
# Unset = the admin API is switched off.
ADMIN_TOKEN=
# How long an unpaid slot is held before it is released (minutes, minimum 16 — Razorpay's minimum link lifetime).
PAYMENT_HOLD_MINUTES=20
# Optional: point Razorpay calls at a proxy or test double.
RAZORPAY_API_BASE=
