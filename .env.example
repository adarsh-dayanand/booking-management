# Postgres
DATABASE_URL=postgres://localhost:5432/booking_management_bot
DATABASE_URL_TEST=postgres://localhost:5432/booking_management_bot_test

# Server
PORT=4000
BASE_URL=http://localhost:4000

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Used to encrypt Google refresh tokens at rest (32 random bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY=replace-with-32-random-bytes-base64

# Google Calendar OAuth (create in Google Cloud Console, see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# WhatsApp Cloud API (create via Meta developer console, see README)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-any-string-you-choose
# Required when NODE_ENV=production (unsigned webhooks are rejected there).
WHATSAPP_APP_SECRET=
# Optional: an approved Meta template whose body is just "{{1}}". Used as a fallback when a free-text
# reminder/approval request fails because the recipient hasn't messaged in the last 24h.
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_NOTIFY_TEMPLATE_LANG=en
# Graph API version used for sending (match the one in your Meta app's API Setup page).
WHATSAPP_GRAPH_VERSION=v25.0

# Background loop (calendar sync, reminders). Set DISABLE_SCHEDULER=1 to turn it off.
SCHEDULER_INTERVAL_MS=300000

# The booking agent. With a key, Gemini runs the conversation (book / check / reschedule / cancel / FAQs).
# Leave blank to fall back to the deterministic numbered-menu flow (book only, no API cost). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Swagger UI at /docs and agent trace (tool calls/results, system prompt) in API responses.
# Both default to ON outside production and OFF in production; set to 1 to force on.
ENABLE_DOCS=
AGENT_TRACE=
# Optional: point Gemini calls at a proxy or test double.
GEMINI_BASE_URL=

# Country code added to 10-digit numbers typed without one, so "98765 43210" and "+91 98765 43210" are the same patient.
DEFAULT_COUNTRY_CODE=91

# Admin = the platform operator (consultants are the clinics, users are the end users). Per-consultant Razorpay keys are
# NOT set here: the admin stores them through PUT /v1/admin/tenants/<slug>/payments, authenticated with this token.
# Unset = the admin API is switched off.
ADMIN_TOKEN=
# How long an unpaid slot is held before it is released (minutes, minimum 16 — Razorpay's minimum link lifetime).
PAYMENT_HOLD_MINUTES=20
# Optional: point Razorpay calls at a proxy or test double.
RAZORPAY_API_BASE=
