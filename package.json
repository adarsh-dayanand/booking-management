{
  "name": "booking-management-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant clinic appointment booking POC: Postgres + Google Calendar, embeddable web chat widget, WhatsApp bot.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:setup": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:setup:test": "psql \"$DATABASE_URL_TEST\" -f db/schema.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "swagger-ui-dist": "^5.33.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-dist": "^3.30.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
